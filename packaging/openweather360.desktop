[Desktop Entry]
Type=Application
Name=OpenWeather360
GenericName=Weather Channel Display
Comment=Retro cable weather channel with live local forecasts and radar
Exec=openweather360
Icon=openweather360
Terminal=false
Categories=Utility;
Keywords=weather;forecast;radar;openweather360;
Actions=Fullscreen;Settings;

[Desktop Action Fullscreen]
Name=Open Fullscreen
Exec=openweather360 --fullscreen

[Desktop Action Settings]
Name=Settings
Exec=openweather360 --settings
